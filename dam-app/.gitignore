# Archivos personalizados
# =======================
# Descomenta según sea necesario para tu proyecto:

# Imágenes de desarrollo (si usas muchas locales)
# /src/assets/images/temp/*

# Archivos de configuración sensible
# config/secrets.json
# .aws/
# .gcloud/

# Subidas/uploads locales
# /uploads/*

# Documentos temporales
# *.pdf
# *.doc
# *.docx

# ============================================
# EXCEPCIONES
# ============================================
# Usa ! para hacer excepciones a las reglas anteriores
# Ejemplo: !.gitkeep para mantener carpetas vacías

# Mantener carpeta uploads aunque esté en .gitignore
# !uploads/.gitkeep

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. **node_modules/** - CRÍTICO:
#    - Nunca subir dependencies instaladas
#    - Se regeneran con: npm install
#
# 2. **.env** - CRÍTICO:
#    - Contiene datos sensibles (contraseñas, API keys, etc.)
#    - Crear .env.example como plantilla
#    - Compartir .env.example, no .env
#
# 3. **dist/** e **build/**:
#    - Se generan automaticamente con npm run build
#    - No necesario subir
#
# 4. **IDE settings** (.vscode, .idea):
#    - Configuración personal de cada desarrollador
#    - Pueden compartir .example o estar en un .gitignore local
#
# 5. **.local** files:
#    - Archivos de desarrollo local
#    - No deben afectar a otros desarrolladores
#
# ============================================
# COMANDOS ÚTILES
# ============================================
#
# Ver archivos ignorados:
# git status --ignored
#
# Forzar agregar un archivo ignorado:
# git add -f [archivo]
#
# Dejar de rastrear sin eliminar:
# git rm --cached [archivo]
#
# Crear archivo .env desde ejemplo:
# cp .env.example .env
#
